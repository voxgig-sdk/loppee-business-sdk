    registry_name: {
      h: "Registry Name"
      n: "registry_name"
      r: true
      t: "`$ANY`"
    }
    results: {
      h: "Results"
      n: "results"
      r: true
      t: "`$ARRAY`"
      union: {
        branches: 8
        count: 2
        depth: 7
      }
    }
    returned_count: {
      h: "Returned Count"
