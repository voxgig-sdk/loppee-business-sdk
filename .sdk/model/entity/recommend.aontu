      h: "Policy"
      n: "policy"
      r: true
      t: "`$STRING`"
    }
    presentation_guidance: {
      h: "Presentation Guidance"
      n: "presentation_guidance"
      r: false
      sh: "Agent-key responses: how to present these results to the customer."
      t: "`$STRING`"
