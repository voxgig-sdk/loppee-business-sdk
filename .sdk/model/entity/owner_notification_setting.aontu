# Entity: owner_notification_setting

main: kit: entity: owner_notification_setting: {

  alias: field: {}

  fields: {
    businessId: {
      h: "Business Id"
      n: "businessId"
      r: true
      t: "`$STRING`"
    }
    business_id: {
      h: "Business Id"
      n: "business_id"
      r: false
      t: "`$STRING`"
    }
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      t: "`$STRING`"
    }
    emailEnabled: {
      h: "Email Enabled"
      n: "emailEnabled"
      r: true
      t: "`$BOOLEAN`"
    }
    email_enabled: {
      h: "Email Enabled"
      n: "email_enabled"
