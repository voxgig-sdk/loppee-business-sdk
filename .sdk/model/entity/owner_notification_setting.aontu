      t: "`$BOOLEAN`"
    }
    eventTypeSubscriptions: {
      h: "Event Type Subscriptions"
      n: "eventTypeSubscriptions"
      r: true
      t: "`$ARRAY`"
    }
    event_types: {
      h: "Event Types"
      n: "event_types"
