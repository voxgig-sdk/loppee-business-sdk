      r: true
      t: "`$STRING`"
    }
    has_more: {
      h: "Has More"
      n: "has_more"
      r: true
      sh: "True only when next_cursor can continue through the current bounded, deterministic candidate window."
      t: "`$BOOLEAN`"
    }
    listed: {
      h: "Listed"
      n: "listed"
      r: true
      t: "`$ARRAY`"
      union: {
        branches: 2
        count: 1
        depth: 5
      }
    }
    location_context: {
      h: "Location Context"
      n: "location_context"
      r: true
      sh: "Local category discovery and recommendations require a current precise location proof or handoff, a user-confirmed validated destination authority, or a saved_exact Home location."
      t: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    ordering: {
      h: "Ordering"
      n: "ordering"
      r: true
      t: "`$ANY`"
    }
