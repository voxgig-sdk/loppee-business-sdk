# BasicAgentPolicyFlow

main: kit: flow: BasicAgentPolicyFlow:
{
  entity: "agent_policy",
  kind: "basic",
  name: "BasicAgentPolicyFlow",
  step: [
    {
      i: {
        ref: "agent_policy_ref01",
        srcdatavar: "agent_policy_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_policy_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAgentPolicyFlow"
}