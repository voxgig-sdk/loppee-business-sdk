# Entity: recommend

main: kit: entity: recommend: {

  alias: field: {}

  fields: {
    candidate_window_truncated: {
      h: "Candidate Window Truncated"
      n: "candidate_window_truncated"
      r: true
      sh: "True when Loppee's bounded candidate assembly reached its safety cap."
      t: "`$BOOLEAN`"
    }
    commercial_influence: {
      h: "Commercial Influence"
      n: "commercial_influence"
      r: true
      sh: "Must be none whenever current-location or saved_exact authority is absent, including universal exact/genuine-prefix name lookup."
      t: "`$STRING`"
    }
    display_count: {
      h: "Display Count"
      n: "display_count"
      r: false
      sh: "Agent-key responses: the number of businesses in this response."
