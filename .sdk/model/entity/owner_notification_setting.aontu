  name: "owner_notification_setting"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "business_id"
            "email_enabled"
            "event_types"
            "webhook_enabled"
          ]
          co: {
            id: "POST /v1/owner/notification-settings"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/v1/owner/notification-settings"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "owner"
            }
            {
              lit: "notification-settings"
            }
          ]
          t: {
            req: {
              business_id: "`reqdata.business_id`"
              email_enabled: "`reqdata.email_enabled`"
              event_types: "`reqdata.event_type`"
              webhook_enabled: "`reqdata.webhook_enabled`"
            }
            res: "`body.settings`"
          }
        }
      ]
    }
  }



